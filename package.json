{
  "name": "codey",
  "version": "0.1.0",
  "private": true,
  "description": "A local Android Neovim client with a bundled editor runtime",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm android:metro",
    "android:metro": "pnpm --filter @codey/android run start",
    "android:install": "pnpm --filter @codey/android run android",
    "android:install:release": "pnpm --filter @codey/android run install:release",
    "android:apk": "pnpm --filter @codey/android run build:apk",
    "android:prepare:nvim": "pnpm --filter @codey/android run prepare:nvim",
    "android:doctor": "pnpm --filter @codey/android run doctor",
    "android:bundle": "pnpm --filter @codey/android run export:android",
    "android:prebuild": "pnpm --filter @codey/android run prebuild:clean",
    "android:test": "pnpm --filter @codey/android run test",
    "android:test:native": "pnpm --filter @codey/android run native:test",
    "android:assemble": "pnpm --filter @codey/android run assemble:debug",
    "android:assemble:release": "pnpm --filter @codey/android run assemble:release",
    "build": "pnpm android:apk",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run && pnpm android:test",
    "test:watch": "vitest",
    "test:live-nvim": "vitest run tests/live-nvim.test.ts",
    "check:android:native": "pnpm --filter @codey/android run native:verify",
    "check": "pnpm typecheck && pnpm test && pnpm android:doctor && pnpm android:bundle && pnpm check:android:native"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
