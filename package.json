{
  "name": "codey",
  "version": "0.1.0",
  "private": true,
  "description": "A remote Neovim client with shared protocol and editor-state packages",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @codey/desktop dev",
    "build": "pnpm --filter @codey/desktop build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live-nvim": "CODEY_LIVE_NVIM=1 vitest run tests/live-nvim.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
